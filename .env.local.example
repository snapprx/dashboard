# ── Dev (local) ────────────────────────────────────────────────────────────────
# Todoist — https://todoist.com/app/settings/integrations/developer
TODOIST_TOKEN=your_todoist_token

# Vault local (dev uniquement, ne pas mettre sur Vercel)
VAULT_PATH=C:\Users\lucas\Projets\Vault\vault

# ── Prod (Vercel) ───────────────────────────────────────────────────────────────
# GitHub PAT avec scope "Contents: Read" sur le repo du Vault
# https://github.com/settings/tokens/new?scopes=repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Nom du repo GitHub du Vault (ex: snapprx/vault)
VAULT_REPO=snapprx/vault

# Branche du Vault (défaut: main)
VAULT_BRANCH=main
